# Maintainer: ZarchBlack <https://github.com/ZarchBlack>
# ZarchBlack Wallpapers - Official wallpaper collection

pkgname=zarchblack-wallpapers
pkgver=1.0.0
pkgrel=3
pkgdesc="ZarchBlack official wallpaper collection - curated high-quality backgrounds"
arch=('any')
url="https://github.com/ZarchBlack/zarchblack"
license=('GPL3')
install=zarchblack-wallpapers.install
source=()
sha256sums=()

package() {
  local _wallpapers_src

  # البحث عن مصدر الخلفيات بعدة طرق متعاقبة
  if [ -d "${startdir}/wallpapers" ]; then
    # مجلد wallpapers/ بجانب PKGBUILD
    _wallpapers_src="${startdir}/wallpapers"
  else
    # البحث التلقائي من موقع البناء صعوداً
    local _project_root
    _project_root="$(git -C "${startdir}" rev-parse --show-toplevel 2>/dev/null || true)"
    if [ -n "$_project_root" ] && [ -d "${_project_root}/iso/airootfs/usr/share/wallpapers" ]; then
      _wallpapers_src="${_project_root}/iso/airootfs/usr/share/wallpapers"
    fi
  fi

  mkdir -p "${pkgdir}/usr/share/wallpapers"

  if [ -n "$_wallpapers_src" ] && [ -d "$_wallpapers_src" ]; then
    cp -r "${_wallpapers_src}/." "${pkgdir}/usr/share/wallpapers/"
    echo "ZarchBlack Wallpapers: installed from ${_wallpapers_src}"
  else
    echo "Warning: wallpapers source not found — package will be empty."
  fi

  mkdir -p "${pkgdir}/usr/share/doc/zarchblack-wallpapers"
  echo "ZarchBlack Wallpapers ${pkgver}" > "${pkgdir}/usr/share/doc/zarchblack-wallpapers/README"
}
