<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>ZarchBlack</vendor>
  <vendor_url>https://github.com/zerolinux-os</vendor_url>

  <action id="org.zarchblack.zarchcare.run-privileged">
    <description>تشغيل أوامر صيانة النظام (pacman) عبر ZarchCare</description>
    <message>يتطلب هذا الإجراء صلاحيات المسؤول لتحديث أو تنظيف النظام</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
